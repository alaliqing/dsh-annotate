{
  "name": "dsh-app-bridge",
  "version": "0.1.0",
  "description": "Expose a local dev server on the DeepSeek Harness origin, and annotate its pages from inside the harness GUI",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alaliqing/dsh-annotate.git",
    "directory": "packages/dsh-app-bridge"
  },
  "homepage": "https://github.com/alaliqing/dsh-annotate#readme",
  "bugs": {
    "url": "https://github.com/alaliqing/dsh-annotate/issues"
  },
  "author": "qinjing <alaliqing@gmail.com>",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "reverse-proxy",
    "dev-server"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "plugin": {
      "name": "dsh-app-bridge"
    }
  }
}
