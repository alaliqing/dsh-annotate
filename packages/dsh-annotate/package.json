{
  "name": "dsh-annotate",
  "version": "0.1.1",
  "description": "Element annotation and review panel for the DeepSeek Harness web client: pick UI elements in a live app preview, write notes, and send them to the conversation as one structured block",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/alaliqing/dsh-annotate.git",
    "directory": "packages/dsh-annotate"
  },
  "homepage": "https://github.com/alaliqing/dsh-annotate#readme",
  "bugs": {
    "url": "https://github.com/alaliqing/dsh-annotate/issues"
  },
  "author": "qinjing <alaliqing@gmail.com>",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "annotation",
    "review",
    "devtools"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node build.mjs",
    "prepack": "node build.mjs"
  },
  "dsh": {
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-sidebar-right",
        "@deepseek-ai/dsh-api-session-controller"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "lib/shim.js",
    "lib/overlay.js",
    "lib/types/**/*.d.ts",
    "cordis.patch.yml",
    "README.md"
  ]
}
